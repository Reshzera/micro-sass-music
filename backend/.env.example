# Port the API listens on
PORT=3000

# Comma-separated list of browser origins allowed to call the API.
# Defaults to the Vite dev/preview servers when unset.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# KIE API (https://kie.ai/api-key) — required.
KIE_API_KEY=

# Optional overrides.
KIE_API_BASE_URL=https://api.kie.ai
KIE_REQUEST_TIMEOUT_MS=30000

# Public URL KIE posts generation updates to, i.e. POST /generations/webhook.
KIE_CALLBACK_URL=

# Shared secret appended to KIE_CALLBACK_URL as ?secret=... and checked on the
# webhook. KIE does not sign its callbacks; leave unset to skip the check.
KIE_CALLBACK_SECRET=

# Postgres from docker-compose.yml at the repo root. Matches POSTGRES_* there.
DATABASE_URL=postgresql://micro_sass:micro_sass@localhost:5433/micro_sass_music?schema=public
